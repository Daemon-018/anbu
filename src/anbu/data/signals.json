{
  "_comment": "Extraction signatures. Method references are matched as substrings of 'Lclass;->method'. Keep this data-only so detection engineers can tune it without touching code.",
  "sink_substrings": [
    "Landroid/telephony/SmsManager;",
    "sendTextMessage",
    "sendMultipartTextMessage",
    "sendDataMessage",
    "Ldalvik/system/DexClassLoader;",
    "Ldalvik/system/PathClassLoader;",
    "Ldalvik/system/InMemoryDexClassLoader;",
    "Ljava/lang/Runtime;->exec",
    "Ljava/lang/ProcessBuilder;",
    "addJavascriptInterface",
    "setJavaScriptEnabled",
    "loadUrl",
    "getDeviceId",
    "getSubscriberId",
    "getLine1Number",
    "getImei",
    "Landroid/content/ContentResolver;->query",
    "Landroid/content/ContentResolver;->rawQuery",
    "Landroid/accessibilityservice/AccessibilityService;",
    "performGlobalAction",
    "Landroid/app/admin/DevicePolicyManager;",
    "lockNow",
    "wipeData",
    "Landroid/content/ClipboardManager;",
    "getPrimaryClip",
    "Landroid/content/pm/PackageManager;->getInstalledPackages",
    "Landroid/content/pm/PackageManager;->getInstalledApplications",
    "Ljava/lang/Class;->forName",
    "getDeclaredMethod",
    "getDeclaredField",
    "Landroid/util/Base64;",
    "Ljavax/crypto/Cipher;",
    "Landroid/service/notification/NotificationListenerService;",
    "Landroid/content/pm/PackageInstaller;",
    "Landroid/webkit/WebView;",
    "Landroid/provider/Telephony$Sms;",
    "Ljava/net/Socket;",
    "Ljava/net/HttpURLConnection;",
    "Lokhttp3/OkHttpClient;",
    "setComponentEnabledSetting",
    "Landroid/telephony/TelephonyManager;"
  ],
  "interesting_keywords": [
    "telegram",
    "discord",
    "webhook",
    "otp",
    "sms",
    "accessibility",
    "payload",
    "dex",
    "su ",
    "busybox",
    "device admin",
    "clipboard",
    "keylog",
    "c2",
    "base64",
    "AES/ECB",
    "DES/ECB",
    "bitcoin",
    "usdt",
    "trc20",
    "install",
    "download",
    "ignore previous",
    "ignore all previous",
    "system prompt"
  ],
  "packers": {
    "qihoo/jiagu": ["libjiagu", "com.qihoo.util", "com.stub.StubApp"],
    "tencent/legu": ["libshella", "libshellx", "com.tencent.StubShell"],
    "baidu": ["com.baidu.protect", "libbaiduprotect"],
    "alibaba": ["com.ali.mobisecenhive", "libmobisec"],
    "bangcle": ["libsecexe", "libsecmain", "com.secneo.apkwrapper"],
    "ijiami": ["libexec.so", "libexecmain.so", "com.shell.helper"],
    "dexguard/dexprotector": ["com.guardsquare.dexguard", "com.licel.dexprotector", "libdexprotector"],
    "netease": ["libnesec"],
    "kiwisec": ["libkiwi"]
  },
  "rank_weights": [
    { "pattern": "AccessibilityService;", "weight": 8, "reason": "accessibility service code" },
    { "pattern": "NotificationListenerService;", "weight": 8, "reason": "notification listener code" },
    { "pattern": "SmsManager;->send", "weight": 8, "reason": "sends SMS" },
    { "pattern": "DevicePolicyManager;->", "weight": 8, "reason": "device policy calls" },
    { "pattern": "Ldalvik/system/DexClassLoader;", "weight": 7, "reason": "loads DEX at runtime" },
    { "pattern": "Ldalvik/system/PathClassLoader;", "weight": 7, "reason": "loads code at runtime" },
    { "pattern": "Ldalvik/system/InMemoryDexClassLoader;", "weight": 7, "reason": "loads in-memory DEX" },
    { "pattern": "Landroid/content/pm/PackageInstaller;", "weight": 6, "reason": "installs packages" },
    { "pattern": "performGlobalAction", "weight": 6, "reason": "automates the UI" },
    { "pattern": "addJavascriptInterface", "weight": 5, "reason": "JavaScript bridge" },
    { "pattern": "setComponentEnabledSetting", "weight": 4, "reason": "toggles components" },
    { "pattern": "getPrimaryClip", "weight": 4, "reason": "reads the clipboard" },
    { "pattern": "Landroid/telephony/TelephonyManager;->getDeviceId", "weight": 3, "reason": "reads telephony identifiers" },
    { "pattern": "Landroid/telephony/TelephonyManager;->getSubscriberId", "weight": 3, "reason": "reads subscriber ID" },
    { "pattern": "ContentResolver;->query", "weight": 3, "reason": "queries content providers" },
    { "pattern": "Ljava/lang/Runtime;->exec", "weight": 4, "reason": "executes shell commands" },
    { "pattern": "Ljava/lang/Class;->forName", "weight": 3, "reason": "reflection by name" },
    { "pattern": "Ljavax/crypto/Cipher;", "weight": 2, "reason": "cryptography" },
    { "pattern": "Landroid/util/Base64;", "weight": 2, "reason": "base64 decoding" },
    { "pattern": "Ljava/net/Socket;", "weight": 2, "reason": "raw sockets" }
  ],
  "rank_keywords": [
    "payload",
    "keylog",
    "steal",
    "spy",
    "bypass",
    "inject",
    "decrypt",
    "exfil",
    "dropper",
    "trojan",
    "ransomware",
    "miner",
    "otp",
    "sms"
  ],
  "rank_ignore_prefixes": [
    "Landroid/",
    "Landroidx/",
    "Ljava/",
    "Ljavax/",
    "Lkotlin/",
    "Lkotlinx/",
    "Ldalvik/",
    "Lorg/jetbrains/",
    "Lorg/intellij/"
  ],
  "suspicious_asset_patterns": [
    "(?i)\\.(dex|jar|apk|zip|so|bin|dat|enc|payload)$",
    "(?i)(payload|encrypt|shell|stub|second_stage)"
  ],
  "media_asset_patterns": [
    "(?i)\\.(png|jpe?g|webp|gif|mp3|mp4|ogg|wav|ttf|otf|woff2?)$"
  ]
}
